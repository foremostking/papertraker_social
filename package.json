{
  "name": "papertracker-social",
  "version": "1.0.0",
  "description": "学术论文写作自动化Web应用",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd web && npm run dev",
    "install:all": "cd web && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
