# ScholarPilot 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ===== LLM API Keys =====
# 至少配置一个。推荐国产模型（智谱GLM-4或火山方舟），国内直连无需代理。

# 智谱AI (GLM-4) - 国产模型，推荐国内用户首选
# 1. 在 https://open.bigmodel.cn 注册并创建 API Key
# 2. API Key 格式：xxxxxxxx.xxxxxxxxxxxxxxxx
# 3. 通过 OpenAI 兼容模式调用，无需额外配置
SCHOLAR_ZHIPU_API_KEY=
SCHOLAR_ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4/
SCHOLAR_ZHIPU_DEFAULT_MODEL=glm-4

# 火山方舟（Volcano Ark / 豆包）- 国产模型，国内直连
# 1. 在 https://www.volcengine.com/product/ark 开通服务
# 2. 创建推理接入点（Endpoint），获取 endpoint ID（形如 ep-2024xxxx-xxxxx）
# 3. 在 API Key 管理页面创建 API Key（形如 ark-xxx）
SCHOLAR_ARK_API_KEY=
SCHOLAR_ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SCHOLAR_ARK_DEFAULT_MODEL=

# Claude (Anthropic) - 英文写作最佳，适合 SSCI/SCI 投稿
SCHOLAR_CLAUDE_API_KEY=

# OpenAI GPT - 通用分析能力强
SCHOLAR_OPENAI_API_KEY=

# DeepSeek - 成本最低，适合轻量任务
SCHOLAR_DEEPSEEK_API_KEY=

# ===== 默认模型配置 =====
# 分阶段配置不同模型，优化成本与质量平衡
# 使用 `scholarpilot model-config --show` 查看当前配置

# 写作用模型（推荐 GLM-4 或 Claude）
# 国内用户：glm-4
# 国际用户：claude-sonnet-4-20250514
SCHOLAR_DEFAULT_WRITING_MODEL=glm-4

# 分析用模型（选题分析/大纲生成，需要强推理）
# 国内用户：glm-4
# 国际用户：gpt-4o
SCHOLAR_DEFAULT_ANALYSIS_MODEL=glm-4

# 日常任务模型（文献检索/引用验证等轻量任务，省钱）
# 国内用户：glm-4
# 国际用户：deepseek/deepseek-chat
SCHOLAR_DEFAULT_CASUAL_MODEL=glm-4

# ===== 项目配置 =====
# 项目根目录（论文项目会存放在此目录下）
SCHOLAR_PROJECTS_DIR=./projects

# MCP Servers 目录
SCHOLAR_MCP_SERVERS_DIR=./mcp-servers

# 全局用户目录（跨论文共享：研究者画像、全局文献库等）
# 默认 ~/.scholarpilot
# SCHOLAR_USER_HOME=

# ===== 学术文献检索 API 配置 =====

# Semantic Scholar API Key（推荐申请，获得稳定 1 RPS 速率）
# 申请地址: https://www.semanticscholar.org/product/api#api-key-form
# 无 Key 也可使用（共享速率，可能被限流）
SCHOLAR_SS_API_KEY=

# 是否启用 arXiv 预印本检索（默认启用，无需 API Key）
SCHOLAR_ARXIV_ENABLED=true

# OpenAlex polite pool 邮箱（可选，提高速率限制）
# SCHOLAR_OPENALEX_MAILTO=your_email@example.com

# ===== CNKI 配置（可选）=====
# 如需使用 CNKI 检索，请配置以下选项之一：
# 1. 提供 CNKI 登录 Cookie（机构账号或个人账号）
# SCHOLAR_CNKI_COOKIE=
#
# 2. 提供代理 API 地址
# SCHOLAR_CNKI_PROXY_URL=

# ===== 文献订阅 Feed 配置（可选）=====
# 每次推送推荐文献的默认数量
# SCHOLAR_FEED_MAX_RECOMMENDATIONS=20
# 是否生成 LLM 推荐理由
# SCHOLAR_FEED_ENABLE_LLM_REASONS=true
# 启用的订阅策略: citation=反向引用追踪, author=同作者追踪, topic=主题增量
# SCHOLAR_FEED_STRATEGIES=citation,author,topic
